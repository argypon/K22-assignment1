diff --git a/include/uapi/linux/k22info.h b/include/uapi/linux/k22info.h
new file mode 100644
index 0000000..fb4ab7a
--- /dev/null
+++ b/include/uapi/linux/k22info.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_K22INFO_H
+#define _UAPI_LINUX_K22INFO_H
+
+#include <linux/types.h>
+
+struct k22info {
+	char comm[64];
+	__kernel_pid_t pid;
+	__kernel_pid_t parent_pid;
+	__kernel_pid_t first_child_pid;
+	__kernel_pid_t next_sibling_pid;
+	unsigned long nvcsw;
+	unsigned long nivcsw;
+	unsigned long start_time;
+	unsigned long userpc;
+	unsigned long kernelpc;
+};
+
+#endif
